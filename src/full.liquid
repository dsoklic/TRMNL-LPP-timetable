<div class="layout layout--left layout--top">
  <div class="columns" data-overflow="true" data-overflow-max-cols="2" data-overflow-max-cols-portrait="2" data-overflow-max-cols-lg="3" data-overflow-max-height="340">
    <div class="column">
      {% for group in data.route_groups %}
        {% for route in group.routes %}
          {% render "route_item" with group: group, route: route, max_minutes: 0 %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

{{ title_bar_markup }}
